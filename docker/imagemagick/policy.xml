<?xml version="1.0" encoding="UTF-8"?>
<!--
  ImageMagick policy for the media variant pipeline (nexus-common/src/media/processors/image.rs).

  Installed as the system policy of the runtime image. Variants are made only from JPEG, PNG, GIF
  and WebP originals, and only WebP is written; every other coder, every delegate and every filter
  is refused, as is @-file indirection. The resource limits match the ones nexusd passes on each
  run: a source over the width or height limit fails at its header, before pixels are allocated,
  and memory, map and disk together bound the pixel cache of one run.

  Check the effective policy inside the container with: convert -list policy
  (no backticks in this comment: the ImageMagick policy parser reads them as quotes and drops the file).
-->
<policymap>
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="512MiB"/>
  <policy domain="resource" name="disk" value="1GiB"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="area" value="128MP"/>
  <policy domain="resource" name="list-length" value="256"/>
  <policy domain="resource" name="time" value="30"/>
  <policy domain="resource" name="thread" value="2"/>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read" pattern="{GIF,JPEG,PNG}"/>
  <policy domain="coder" rights="read|write" pattern="WEBP"/>
  <policy domain="path" rights="none" pattern="@*"/>
</policymap>
